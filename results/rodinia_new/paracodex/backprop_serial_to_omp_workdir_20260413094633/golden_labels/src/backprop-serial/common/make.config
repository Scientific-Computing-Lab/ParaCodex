# CUDA toolkit installation path
CUDA_DIR = /opt/nvidia/hpc_sdk/Linux_x86_64/25.7/cuda/12.9

# CUDA toolkit libraries
CUDA_LIB_DIR := $(CUDA_DIR)/targets/x86_64-linux/lib
ifeq ($(shell uname -m), x86_64)
     ifeq ($(shell if test -d $(CUDA_DIR)/targets/x86_64-linux/lib; then echo T; else echo F; fi), T)
     	CUDA_LIB_DIR := $(CUDA_DIR)/targets/x86_64-linux/lib
     endif
endif

# CUDA SDK installation path
SDK_DIR = $(CUDA_DIR)/samples/

# OPENCL

# NVIDIA_DIR
NV_OPENCL_DIR = /opt/nvidia/hpc_sdk/Linux_x86_64/25.7/cuda/12.9
NV_OPENCL_INC = $(NV_OPENCL_DIR)/targets/x86_64-linux/include
NV_OPENCL_LIB = $(NV_OPENCL_DIR)/targets/x86_64-linux/lib

# INTEL_DIR
INTEL_OPENCL_DIR = /opt/intel/opencl
INTEL_OPENCL_INC = $(INTEL_OPENCL_DIR)/include
INTEL_OPENCL_LIB = $(INTEL_OPENCL_DIR)

# AMD_DIR
# OPENCL_DIR = /usr/local/cuda
# OPENCL_INC = $(OPENCL_DIR)/include/ 
# OPENCL_LIB = $(OPENCL_DIR)/lib/x86_64/ -lOpenCL
#ifeq ($(shell uname -m), x86_64)
#     ifeq ($(shell if test -d $(OPENCL_DIR)/lib/x86_64/; then echo T; else echo F; fi), T)
#     	OPENCL_LIB = $(OPENCL_DIR)/lib/x86_64/
#     endif
#endif

# DEFAULT OCL
OPENCL_DIR = $(NV_OPENCL_DIR)
OPENCL_INC = $(NV_OPENCL_INC)
OPENCL_LIB = $(NV_OPENCL_LIB)
