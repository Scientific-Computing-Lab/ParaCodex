# Makefile for b+tree-serial reference verification

CC        = nvc
OPTIMIZE  = no
DEBUG     = no
DEVICE    = gpu
SM        = cc89
GATE_ROOT ?= $(abspath ../../..)
VERIFY_CPPFLAGS ?= -DGATE_VERIFY

program = b+tree.out

source = main.c util/num/num.c util/timer/timer.c kernel/kernel_cpu.c kernel/kernel_cpu_2.c

obj = $(source:.c=.o)

CFLAGS := $(EXTRA_CFLAGS) -std=c11 -Wall -include stdbool.h -I$(GATE_ROOT)/gate_sdk -I.
LDFLAGS = -lm

ifeq ($(DEBUG),yes)
  CFLAGS += -g -DDEBUG
  LDFLAGS += -g
endif

ifeq ($(OPTIMIZE),yes)
  CFLAGS += -O3
endif

ifeq ($(DEVICE),gpu)
  CFLAGS += -Minfo=mp -mp=gpu -gpu=$(SM)
else
  CFLAGS += -qopenmp
endif

$(program): $(obj)
	$(CC) $(CFLAGS) $(obj) -o $@ $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(program) $(obj)
