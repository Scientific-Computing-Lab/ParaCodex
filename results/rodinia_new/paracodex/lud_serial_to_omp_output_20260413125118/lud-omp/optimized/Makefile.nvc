# Makefile for lud-serial (omp version)

#===============================================================================
# User Options
#===============================================================================

# Compiler can be set below, or via environment variable
CC        = nvc
OPTIMIZE  = yes
DEBUG     = no
DEVICE    = gpu
SM        = cc89
LAUNCHER  = env OMP_TARGET_OFFLOAD=MANDATORY
GATE_ROOT ?= $(abspath ../../..)
REF_DIR   ?= $(GATE_ROOT)/golden_labels/src/lud-serial
REF_BIN   ?= $(REF_DIR)/omp/lud_omp
REF_MAKE  ?= Makefile
VERIFY_CPPFLAGS ?= -DGATE_VERIFY -I$(GATE_ROOT)/gate_sdk

RUN_ARGS ?= -s 2048

#===============================================================================
# Program name & source code list
#===============================================================================

program = lud_omp

source = omp/lud.c omp/lud_omp.c common/common.c

obj = $(source:.c=.o)

#===============================================================================
# Sets Flags
#===============================================================================

# Standard Flags
CFLAGS := $(EXTRA_CFLAGS) -std=c11 -Wall -I$(GATE_ROOT)/golden_labels/src/lud-serial/common
LDFLAGS = 

# Debug Flags
ifeq ($(DEBUG),yes)
  CFLAGS += -g -DDEBUG
  LDFLAGS  += -g
endif


# Optimization Flags
ifeq ($(OPTIMIZE),yes)
  CFLAGS += -O3
endif

ifeq ($(DEVICE),gpu)
  CFLAGS += -Minfo=mp -mp=gpu -gpu=$(SM)
  LDFLAGS += -mp=gpu -gpu=$(SM)
else
  CFLAGS +=-qopenmp
endif
#===============================================================================
# Targets to Build
#===============================================================================

$(program): $(obj)
	$(CC) $(CFLAGS) $(obj) -o $@ $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(program) $(obj)

run: $(program)
	$(LAUNCHER) ./$(program) $(RUN_ARGS)

.PHONY: ref_build
ref_build:
	$(MAKE) -C $(REF_DIR) -f $(REF_MAKE) clean
	$(MAKE) -C $(REF_DIR) -f $(REF_MAKE) CC="$(CC)" OPTIMIZE="$(OPTIMIZE)" DEBUG="$(DEBUG)" DEVICE="$(DEVICE)" SM="$(SM)" CFLAGS="$(CFLAGS) -I$(GATE_ROOT)/gate_sdk"

.PHONY: verify_build
verify_build:
	$(MAKE) -f Makefile.nvc clean
	$(MAKE) -f Makefile.nvc EXTRA_CFLAGS="$(VERIFY_CPPFLAGS) $(EXTRA_CFLAGS)"

.PHONY: ref_verify_build
ref_verify_build:
	$(MAKE) -C $(REF_DIR) -f $(REF_MAKE) clean
	$(MAKE) -C $(REF_DIR) -f $(REF_MAKE) CC="$(CC)" OPTIMIZE="$(OPTIMIZE)" DEBUG="$(DEBUG)" DEVICE="$(DEVICE)" SM="$(SM)" CFLAGS="$(VERIFY_CPPFLAGS) $(CFLAGS) -I$(GATE_ROOT)/gate_sdk" LDFLAGS="$(LDFLAGS)"

.PHONY: check-correctness
check-correctness: verify_build ref_verify_build
	OMP_TARGET_OFFLOAD=MANDATORY python3 $(GATE_ROOT)/gate_sdk/scripts/gate_harness.py $(REF_BIN) ./$(program) $(RUN_ARGS)
