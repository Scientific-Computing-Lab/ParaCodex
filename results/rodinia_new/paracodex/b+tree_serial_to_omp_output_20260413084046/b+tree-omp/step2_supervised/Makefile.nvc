# Makefile for b+tree-serial (omp version)

#===============================================================================
# User Options
#===============================================================================

# Compiler can be set below, or via environment variable
CC        = nvc
OPTIMIZE  = no
DEBUG     = no
DEVICE    = gpu
SM        = cc89
LAUNCHER  =
GATE_ROOT ?= $(abspath ../../..)
REF_DIR   ?= $(GATE_ROOT)/golden_labels/src/b+tree-serial
REF_BIN   ?= $(REF_DIR)/b+tree.out
REF_MAKE  ?= Makefile.nvc
VERIFY_CPPFLAGS ?= -DGATE_VERIFY

RUN_ARGS ?= file input/mil.txt command input/commands.txt

#===============================================================================
# Program name & source code list
#===============================================================================

program = bptree

source = main.c util/num/num.c util/timer/timer.c kernel/kernel_cpu.c kernel/kernel_cpu_2.c

obj = $(source:.c=.o)

#===============================================================================
# Sets Flags
#===============================================================================

# Standard Flags
CFLAGS := $(EXTRA_CFLAGS) -std=c11 -Wall -I$(GATE_ROOT)/gate_sdk -I.
LDFLAGS = -lm

# Debug Flags
ifeq ($(DEBUG),yes)
  CFLAGS += -g -DDEBUG
  LDFLAGS  += -g
endif


# Optimization Flags
ifeq ($(OPTIMIZE),yes)
  CFLAGS += -O3
endif

ifeq ($(DEVICE),gpu)
  CFLAGS += -Minfo=mp -mp=gpu -gpu=$(SM)
else
  CFLAGS += -qopenmp
endif
#===============================================================================
# Targets to Build
#===============================================================================

$(program): $(obj)
	$(CC) $(CFLAGS) $(obj) -o $@ $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(program) $(obj)

run: $(program)
	OMP_TARGET_OFFLOAD=MANDATORY $(LAUNCHER) ./$(program) $(RUN_ARGS)

.PHONY: ref_build
ref_build:
	$(MAKE) -C $(REF_DIR) -f $(REF_MAKE) clean
	$(MAKE) -C $(REF_DIR) -f $(REF_MAKE) CC="$(CC)" OPTIMIZE="$(OPTIMIZE)" DEBUG="$(DEBUG)" DEVICE="$(DEVICE)" SM="$(SM)" GATE_ROOT="$(GATE_ROOT)"

.PHONY: verify_build
verify_build:
	$(MAKE) -f Makefile.nvc clean
	$(MAKE) -f Makefile.nvc EXTRA_CFLAGS="$(VERIFY_CPPFLAGS) $(EXTRA_CFLAGS)"

.PHONY: ref_verify_build
ref_verify_build:
	$(MAKE) -C $(REF_DIR) -f $(REF_MAKE) clean
	$(MAKE) -C $(REF_DIR) -f $(REF_MAKE) CC="$(CC)" OPTIMIZE="$(OPTIMIZE)" DEBUG="$(DEBUG)" DEVICE="$(DEVICE)" SM="$(SM)" GATE_ROOT="$(GATE_ROOT)" EXTRA_CFLAGS="$(VERIFY_CPPFLAGS)"

.PHONY: check-correctness
check-correctness: verify_build ref_verify_build
	OMP_TARGET_OFFLOAD=MANDATORY python3 $(GATE_ROOT)/gate_sdk/scripts/gate_harness.py $(REF_BIN) ./$(program) $(RUN_ARGS)
