# Makefile for b+tree-serial (omp version)

#===============================================================================
# User Options
#===============================================================================

# Compiler can be set below, or via environment variable
CC        = nvc++
OPTIMIZE  = yes
DEBUG     = no
DEVICE    = gpu
SM        = cc89
LAUNCHER  =
GATE_ROOT ?= $(abspath ../../..)
REF_DIR   ?= $(GATE_ROOT)/data/src/b+tree-omp
REF_BIN   ?= $(REF_DIR)/b+tree.ref.out
REF_MAKE  ?= Makefile.nvc

RUN_ARGS ?= cores 2 file ../../../data/b+tree/mil.txt command ../../../data/b+tree/command.txt

#===============================================================================
# Program name & source code list
#===============================================================================

program = b+tree.out

source = main.c kernel/kernel_cpu.c kernel/kernel_cpu_2.c util/timer/timer.c util/num/num.c

obj = $(source:.c=.o)

#===============================================================================
# Sets Flags
#===============================================================================

# Standard Flags
CFLAGS := $(EXTRA_CFLAGS) -std=c++14 -Wall -I$(GATE_ROOT)/gate_sdk -I.
LDFLAGS = 

# Debug Flags
ifeq ($(DEBUG),yes)
  CFLAGS += -g -DDEBUG
  LDFLAGS  += -g
endif


# Optimization Flags
ifeq ($(OPTIMIZE),yes)
  CFLAGS += -O3
endif

ifeq ($(DEVICE),gpu)
  CFLAGS += -Minfo=mp -mp=gpu -gpu=$(SM)
else
  CFLAGS +=-qopenmp
endif
#===============================================================================
# Targets to Build
#===============================================================================

$(program): $(obj)
	$(CC) $(CFLAGS) $(obj) -o $@ $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(program) $(obj)

run: $(program)
	$(LAUNCHER) ./$(program) $(RUN_ARGS)

.PHONY: ref_build
ref_build:
	-$(MAKE) -C $(REF_DIR) -f $(REF_MAKE) clean program=b+tree.ref.out
	$(MAKE) -C $(REF_DIR) -f $(REF_MAKE) program=b+tree.ref.out C_C="$(CC) -mp=gpu -gpu=$(SM)" OMP_FLAG="-std=c++14 -Wall -I$(GATE_ROOT)/gate_sdk -I. -O3 -Minfo=mp" OMP_LIB="$(LDFLAGS)"

.PHONY: check-correctness
check-correctness: $(program) ref_build
	OMP_TARGET_OFFLOAD=MANDATORY python3 $(GATE_ROOT)/gate_sdk/scripts/gate_harness.py $(REF_BIN) ./$(program) $(RUN_ARGS)
